---
import { getCollection, getEntry, render } from "astro:content";
import DocLayout from "../../layouts/DocLayout.astro";

/**
 * `/self-hosting/<slug>/` — one hand-written page per `self-host-*` `siteDocs`
 * entry (T4.1.1, HITL-4). Mirrors `quickstart.astro`'s shape exactly: a
 * `siteDocs` entry has no route of its own (`[...slug].astro` builds only
 * from the `docs` collection), so each one needs a page like this that calls
 * `getEntry("siteDocs", …)` directly.
 *
 * `slug` here is the SHORT, public-facing form (`install`, `upgrade`, …); the
 * `siteDocs` entry id is `self-host-<slug>` — kept flat and prefixed at the
 * content-file level (D17) precisely so it can never collide with the
 * importer-owned `docs` collection's `<section>/<slug>.md` pattern, while the
 * public URL stays a clean `/self-hosting/<slug>/`.
 */
export async function getStaticPaths() {
  const selfHostingSlugs = [
    "install",
    "upgrade",
    "config-reference",
    "air-gap",
    "troubleshooting",
  ];
  const docsEntries = await getCollection("docs");
  const paths = [];
  for (const slug of selfHostingSlugs) {
    const entry = await getEntry("siteDocs", `self-host-${slug}`);
    if (!entry) throw new Error(`content/self-host-${slug}.md is missing`);
    paths.push({ params: { slug }, props: { entry, entries: docsEntries, slug } });
  }
  return paths;
}

const { entry, entries, slug } = Astro.props;
const { Content } = await render(entry);
---

<DocLayout
  title={entry.data.title}
  description={entry.data.description}
  entries={entries}
  selfHostingActive={slug}
>
  <Content />
</DocLayout>
