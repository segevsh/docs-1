---
import { getEntry, render } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";

/**
 * `/` — the docs home page: the hand-authored `site-docs` `index` entry,
 * followed by links to the get-started, self-hosting and guides landings.
 */
const index = await getEntry("siteDocs", "index");
if (!index) throw new Error("content/index.md is missing");

const { Content } = await render(index);

---

<BaseLayout title={index.data.title} description={index.data.description}>
  <Content />

  <section class="docs-index" aria-label="Start here">
    <ul>
      <li><a href="/get-started/">Get started</a></li>
      <li><a href="/self-hosting/">Self-hosting</a></li>
      <li><a href="/guides/">Guides</a></li>
    </ul>
  </section>
</BaseLayout>
