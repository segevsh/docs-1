---
import type { CollectionEntry } from "astro:content";
import BaseLayout from "./BaseLayout.astro";

/**
 * Docs layout: section rail + content. Mirrors the shape of
 * `packages/frontend/packages/web/src/layouts/DocsLayout.astro` — this
 * repo's own exemplar for T3.1.1/T3.1.2/T3.1.3 — simplified for v1 (no
 * on-this-page TOC).
 */
interface Props {
  title: string;
  description?: string;
  /** Every `docs` entry — the rail is built from this, grouped by `section`. */
  entries: CollectionEntry<"docs">[];
  /** The entry currently being viewed, highlighted in the rail. */
  currentId?: string;
}

const { title, description, entries, currentId } = Astro.props;

/** Group by `section`, in first-seen order. */
const grouped = new Map<string, CollectionEntry<"docs">[]>();
for (const entry of entries) {
  const list = grouped.get(entry.data.section) ?? [];
  list.push(entry);
  grouped.set(entry.data.section, list);
}
const sections = [...grouped].map(([section, sectionEntries]) => ({
  section,
  entries: sectionEntries,
}));
---

<BaseLayout title={title} description={description}>
  <div class="docs-layout">
    <nav class="docs-rail" aria-label="Docs">
      {sections.map(({ section, entries: sectionEntries }) => (
        <div class="docs-rail-section">
          <h2>{section}</h2>
          <ul>
            {sectionEntries.map((entry) => (
              <li>
                <a
                  href={`/${entry.id}/`}
                  aria-current={entry.id === currentId ? "page" : undefined}
                >
                  {entry.data.title}
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </nav>
    <div class="docs-content">
      <slot />
    </div>
  </div>
</BaseLayout>
