---
import { getCollection, getEntry, render } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";

/**
 * `/` — the docs home page: the hand-authored `site-docs` `index` entry,
 * followed by every `docs` entry grouped by section.
 *
 * With the `docs` collection empty (nothing imported yet — T3.1.2's job)
 * this renders the intro alone and stays green (A1/A8).
 */
const entries = await getCollection("docs");

const index = await getEntry("siteDocs", "index");
if (!index) throw new Error("src/content/site-docs/index.md is missing");

const { Content } = await render(index);

const grouped = new Map<string, typeof entries>();
for (const entry of entries) {
  const list = grouped.get(entry.data.section) ?? [];
  list.push(entry);
  grouped.set(entry.data.section, list);
}
const sections = [...grouped].map(([section, sectionEntries]) => ({
  section,
  entries: sectionEntries,
}));
---

<BaseLayout title={index.data.title} description={index.data.description}>
  <Content />

  <section class="docs-index" aria-label="All docs">
    <h2>All docs</h2>
    {sections.length === 0 ? (
      <p>No docs imported yet.</p>
    ) : (
      sections.map(({ section, entries: sectionEntries }) => (
        <div class="docs-index-section">
          <h3>{section}</h3>
          <ul>
            {sectionEntries.map((entry) => (
              <li><a href={`/${entry.id}/`}>{entry.data.title}</a></li>
            ))}
          </ul>
        </div>
      ))
    )}
  </section>
</BaseLayout>
