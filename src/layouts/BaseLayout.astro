---
/**
 * Base layout — shared shell for every page: <head>, top bar, footer.
 * Pages / `DocLayout` provide the middle via <slot />.
 */
interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = "Documentation for every open-source w6w package, imported straight from each repo's own docs/ folder.",
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{title} — w6w docs</title>
    <style is:global>
      @import "../styles/global.css";
    </style>
  </head>
  <body>
    <header class="topbar">
      <div class="topbar-inner">
        <a class="brand" href="/">w6w docs</a>
        <nav class="nav" aria-label="Site">
          <a href="/">Docs</a>
          <a href="https://w6w.io" rel="noopener noreferrer">w6w.io</a>
          <a href="https://github.com/w6w-io" target="_blank" rel="noopener noreferrer">GitHub</a>
        </nav>
      </div>
    </header>

    <main class="page-body">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="footer-inner">
        <span>&copy; {new Date().getFullYear()} w6w</span>
      </div>
    </footer>
  </body>
</html>
